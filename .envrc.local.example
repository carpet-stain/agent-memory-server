# shellcheck shell=bash
# Copy this file to .envrc.local. Routine GitHub auth is the vended token,
# mapped in .envrc — leave GH_TOKEN empty. Escape hatch: if the vended path
# is down for long, mint a fresh fine-grained PAT (Contents/Pull
# requests/Actions read-write, NOT Administration) and fill it here — a
# non-empty value wins over the vended mapping. Use
# `env -u GH_TOKEN -u GITHUB_TOKEN gh ...` for anything that needs the
# full-admin session instead (both vars, since .envrc aliases GITHUB_TOKEN
# to this same scoped token and gh prefers it) — e.g. the branch-protection
# bootstrap script. Design and grant detail: dotfiles' AGENTS.md Credentials
# section, infra ADR-0010.
export GH_TOKEN=

# A disposable local/dockerized Postgres, never a real Neon database — the
# concurrency and round-trip tests create and drop tables against this.
export DATABASE_URL_TEST=

# `pnpm run dev`'s own store. Role→bearer/database mapping the server loads
# once at boot (see src/config.ts); production values live in SSM
# (infra#240), never here.
export AGENT_MEMORY_ROLE_CREDENTIALS=

# Tofu inputs (terraform/variables.tf) — identifiers, not secrets; CI
# supplies the same four as repo variables (docs/CODING.md). Values come
# from infra's `just tofu-gcp output` / `just tofu-iam output`, and the
# Neon org id from the org settings page.
export TF_VAR_neon_org_id=
export TF_VAR_gcp_project_id=
export TF_VAR_container_image=
export TF_VAR_ssm_read_role_arn=
